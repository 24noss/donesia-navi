---
import { cuisineConfig, priceLabels } from '../lib/cuisines';

interface Props {
  restaurants: string;
  height?: string;
}

const { restaurants, height = '520px' } = Astro.props;
const GMAP_KEY = 'AIzaSyCU3hYfihH03MjQAxVSHjh49JCK2tOMzdQ';
---

<div class="restaurant-map-wrap">
  <div class="map-cuisine-filters" id="map-cuisine-filters"></div>
  <div class="map-cuisine-filters" id="map-area-filters"></div>
  <div class="map-toolbar">
    <button type="button" id="map-geolocate-btn" class="map-geolocate-btn">📍 現在地から探す</button>
  </div>
  <div id="restaurant-map" style={`height:${height};width:100%;border-radius:var(--radius-lg);border:1px solid var(--border);background:#e8e6e1;`}></div>
</div>

<style>
  /* Statically rendered elements: Astro's scoped-style attribute applies normally. */
  .map-toolbar {
    margin-bottom: 10px;
  }
  .map-geolocate-btn {
    padding: 5px 14px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 500;
    background: var(--bg-sidebar);
    color: var(--text);
    border: 1px solid var(--border);
    cursor: pointer;
    transition: all .15s;
  }
  .map-geolocate-btn:hover {
    border-color: var(--teal);
    color: var(--teal);
  }
  .map-geolocate-btn:disabled {
    opacity: .6;
    cursor: default;
  }

  /* The rules below target elements created dynamically by the inline script below
     (halal toggle + its caption). Dynamically created nodes never receive Astro's
     scoping attribute, so :global() is required for these selectors to take effect. */
  :global(.map-filter-halal) {
    border-color: #3f7d5c !important;
  }
  :global(.map-filter-halal.active) {
    background: #3f7d5c;
    color: #fff;
    border-color: #3f7d5c !important;
  }
  :global([data-theme="dark"] .map-filter-halal.active) {
    background: #4c9770;
    border-color: #4c9770 !important;
  }
  :global(.map-filter-note) {
    font-size: 11px;
    color: var(--text-muted);
    align-self: center;
    margin-left: 4px;
  }
</style>

<script is:inline define:vars={{ restaurants, GMAP_KEY, cuisineConfig, priceLabels }}>
(function() {
  var data = JSON.parse(restaurants);

  // cuisineConfig and priceLabels are injected above via define:vars from
  // src/lib/cuisines.ts — the single source of truth for cuisine label/color/icon
  // and price symbols. Do not redeclare them locally in this script.

  // Count cuisines
  var cuisineCounts = {};
  data.forEach(function(r) {
    cuisineCounts[r.cuisine] = (cuisineCounts[r.cuisine] || 0) + 1;
  });

  // Count areas (area values are freeform strings from mapData, not an enum)
  var areaCounts = {};
  data.forEach(function(r) {
    if (!r.area) return;
    areaCounts[r.area] = (areaCounts[r.area] || 0) + 1;
  });
  var areaNames = Object.keys(areaCounts).sort();

  // Render cuisine filter buttons + alcohol/halal toggles
  var filtersEl = document.getElementById('map-cuisine-filters');
  if (filtersEl) {
    var allBtn = document.createElement('button');
    allBtn.className = 'map-filter-btn active';
    allBtn.dataset.cuisine = 'all';
    allBtn.textContent = 'すべて (' + data.length + ')';
    filtersEl.appendChild(allBtn);

    Object.keys(cuisineConfig).forEach(function(key) {
      if (!cuisineCounts[key]) return;
      var btn = document.createElement('button');
      btn.className = 'map-filter-btn';
      btn.dataset.cuisine = key;
      btn.innerHTML = cuisineConfig[key].icon + ' ' + cuisineConfig[key].label + ' (' + cuisineCounts[key] + ')';
      btn.style.setProperty('--filter-color', cuisineConfig[key].color);
      filtersEl.appendChild(btn);
    });

    // Alcohol filter toggle (hidden when no match, matches pre-existing behavior)
    var alcCount = data.filter(function(r) { return r.servesAlcohol === 'yes'; }).length;
    if (alcCount > 0) {
      var alcBtn = document.createElement('button');
      alcBtn.className = 'map-filter-btn map-filter-alcohol';
      alcBtn.dataset.filter = 'alcohol';
      alcBtn.innerHTML = '🍺 お酒あり (' + alcCount + ')';
      alcBtn.style.marginLeft = '8px';
      filtersEl.appendChild(alcBtn);
    }

    // Halal filter toggle — always rendered (even at 0 matches) since absence of
    // verified halal data is itself useful information to the user.
    var halalCount = data.filter(function(r) { return r.halal === 'yes'; }).length;
    var halalBtn = document.createElement('button');
    halalBtn.className = 'map-filter-btn map-filter-halal';
    halalBtn.dataset.filter = 'halal';
    halalBtn.innerHTML = '🕌 ハラール対応 (' + halalCount + ')';
    halalBtn.style.marginLeft = alcCount > 0 ? '4px' : '8px';
    filtersEl.appendChild(halalBtn);

    var halalNote = document.createElement('span');
    halalNote.className = 'map-filter-note';
    halalNote.textContent = '※確認済みの店舗のみ';
    filtersEl.appendChild(halalNote);
  }

  // Render area filter buttons
  var areaFiltersEl = document.getElementById('map-area-filters');
  if (areaFiltersEl && areaNames.length > 0) {
    var allAreaBtn = document.createElement('button');
    allAreaBtn.className = 'map-filter-btn active';
    allAreaBtn.dataset.area = 'all';
    allAreaBtn.textContent = 'すべてのエリア (' + data.length + ')';
    areaFiltersEl.appendChild(allAreaBtn);

    areaNames.forEach(function(area) {
      var btn = document.createElement('button');
      btn.className = 'map-filter-btn';
      btn.dataset.area = area;
      btn.textContent = area + ' (' + areaCounts[area] + ')';
      areaFiltersEl.appendChild(btn);
    });
  }

  // Load Google Maps
  function loadGoogleMaps(cb) {
    if (window.google && window.google.maps) { cb(); return; }
    window._gmapCallback = cb;
    var s = document.createElement('script');
    s.src = 'https://maps.googleapis.com/maps/api/js?key=' + GMAP_KEY + '&callback=_gmapCallback&v=weekly&language=ja';
    s.async = true;
    s.defer = true;
    document.head.appendChild(s);
  }

  function initWhenVisible() {
    var mapEl = document.getElementById('restaurant-map');
    if (!mapEl) return;

    if (mapEl.offsetParent !== null && mapEl.offsetWidth > 0) {
      loadGoogleMaps(initMap);
      return;
    }

    // Observe for tab switching
    var obs = new MutationObserver(function() {
      if (mapEl.offsetParent !== null && mapEl.offsetWidth > 0) {
        obs.disconnect();
        loadGoogleMaps(initMap);
      }
    });
    obs.observe(document.body, { attributes: true, childList: true, subtree: true });

    setTimeout(function() {
      if (mapEl.offsetParent !== null && mapEl.offsetWidth > 0) {
        obs.disconnect();
        loadGoogleMaps(initMap);
      }
    }, 1000);
  }

  var mapInstance = null;
  var allMarkers = [];
  var userLocationMarker = null;

  function initMap() {
    if (mapInstance) return;

    var mapEl = document.getElementById('restaurant-map');
    if (!mapEl || !window.google) return;

    var isDark = document.documentElement.getAttribute('data-theme') === 'dark';

    var darkStyle = [
      { elementType: 'geometry', stylers: [{ color: '#1d2c4d' }] },
      { elementType: 'labels.text.fill', stylers: [{ color: '#8ec3b9' }] },
      { elementType: 'labels.text.stroke', stylers: [{ color: '#1a3646' }] },
      { featureType: 'road', elementType: 'geometry', stylers: [{ color: '#304a7d' }] },
      { featureType: 'road', elementType: 'labels.text.fill', stylers: [{ color: '#98a5be' }] },
      { featureType: 'water', elementType: 'geometry', stylers: [{ color: '#0e1626' }] },
      { featureType: 'poi', elementType: 'geometry', stylers: [{ color: '#283d6a' }] },
      { featureType: 'transit', elementType: 'geometry', stylers: [{ color: '#2f3948' }] },
    ];

    var map = new google.maps.Map(mapEl, {
      center: { lat: -6.2088, lng: 106.8456 },
      zoom: 12,
      styles: isDark ? darkStyle : [],
      mapTypeControl: false,
      streetViewControl: false,
      fullscreenControl: true,
      zoomControlOptions: { position: google.maps.ControlPosition.RIGHT_BOTTOM },
    });
    mapInstance = map;

    // Theme change observer
    new MutationObserver(function(mutations) {
      mutations.forEach(function(m) {
        if (m.attributeName === 'data-theme') {
          var dark = document.documentElement.getAttribute('data-theme') === 'dark';
          map.setOptions({ styles: dark ? darkStyle : [] });
        }
      });
    }).observe(document.documentElement, { attributes: true });

    // Create markers
    var bounds = new google.maps.LatLngBounds();
    var infoWindow = new google.maps.InfoWindow();

    data.forEach(function(r) {
      if (!r.lat || !r.lng) return;
      var cc = cuisineConfig[r.cuisine] || cuisineConfig.other;

      var marker = new google.maps.Marker({
        position: { lat: r.lat, lng: r.lng },
        map: map,
        title: r.name,
        icon: {
          path: google.maps.SymbolPath.CIRCLE,
          scale: 12,
          fillColor: cc.color,
          fillOpacity: 0.9,
          strokeColor: '#ffffff',
          strokeWeight: 2.5,
        },
        label: {
          text: cc.icon,
          fontSize: '14px',
        },
      });

      var gmapsUrl = 'https://www.google.com/maps/search/' + encodeURIComponent(r.googleMapsQuery);

      var content = '<div style="font-family:Noto Sans JP,sans-serif;min-width:220px;line-height:1.6;padding:4px;">'
        + '<div style="font-size:16px;font-weight:700;color:#1B2D4F;margin-bottom:2px;">' + r.name + '</div>'
        + (r.nameEn ? '<div style="font-size:12px;color:#888;">' + r.nameEn + '</div>' : '')
        + '<div style="margin:8px 0 6px;">'
        + '<span style="display:inline-block;background:' + cc.color + ';color:#fff;padding:2px 10px;border-radius:4px;font-size:11px;font-weight:600;">' + cc.icon + ' ' + cc.label + '</span> '
        + '<span style="font-size:14px;color:#1B2D4F;font-weight:700;margin-left:4px;">' + (priceLabels[r.priceRange] || '') + '</span>'
        + '</div>'
        + '<div style="font-size:13px;color:#555;margin-bottom:8px;">📍 ' + r.area + '</div>'
        + '<div style="display:flex;gap:12px;padding-top:8px;border-top:1px solid #eee;">'
        + '<a href="' + gmapsUrl + '" target="_blank" rel="noopener noreferrer" style="font-size:12px;color:#3A6B8C;text-decoration:none;font-weight:600;">Google Map ↗</a>'
        + (r.articleSlug ? '<a href="/articles/' + r.articleSlug + '/" style="font-size:12px;color:#3A6B8C;text-decoration:none;font-weight:600;">記事を読む →</a>' : '')
        + '</div></div>';

      marker.addListener('click', function() {
        infoWindow.setContent(content);
        infoWindow.open(map, marker);
      });

      marker._cuisine = r.cuisine;
      marker._area = r.area;
      marker._servesAlcohol = r.servesAlcohol || 'unverified';
      marker._halal = r.halal || 'unverified';
      allMarkers.push(marker);
      bounds.extend(marker.getPosition());
    });

    if (allMarkers.length > 0) {
      map.fitBounds(bounds, { top: 50, bottom: 50, left: 50, right: 50 });
    }

    // Filter logic (cuisine / area / alcohol / halal all combine with AND)
    var alcoholFilterActive = false;
    var halalFilterActive = false;
    var activeCuisine = 'all';
    var activeArea = 'all';

    function applyFilters() {
      allMarkers.forEach(function(m) {
        var cuisineMatch = (activeCuisine === 'all' || m._cuisine === activeCuisine);
        var areaMatch = (activeArea === 'all' || m._area === activeArea);
        var alcoholMatch = !alcoholFilterActive || m._servesAlcohol === 'yes';
        var halalMatch = !halalFilterActive || m._halal === 'yes';
        if (cuisineMatch && areaMatch && alcoholMatch && halalMatch) {
          m.setVisible(true);
          m.setIcon(Object.assign({}, m.getIcon(), { fillOpacity: 0.9, scale: 12 }));
        } else {
          m.setVisible(false);
        }
      });

      // Re-fit bounds to visible markers
      var newBounds = new google.maps.LatLngBounds();
      var count = 0;
      allMarkers.forEach(function(m) {
        if (m.getVisible()) { newBounds.extend(m.getPosition()); count++; }
      });
      if (count > 0) {
        map.fitBounds(newBounds, { top: 50, bottom: 50, left: 50, right: 50 });
      } else if (!alcoholFilterActive && !halalFilterActive && activeCuisine === 'all' && activeArea === 'all') {
        map.fitBounds(bounds, { top: 50, bottom: 50, left: 50, right: 50 });
      }
    }

    if (filtersEl) {
      filtersEl.addEventListener('click', function(e) {
        var btn = e.target.closest('.map-filter-btn');
        if (!btn) return;

        // Handle alcohol toggle separately
        if (btn.dataset.filter === 'alcohol') {
          alcoholFilterActive = !alcoholFilterActive;
          btn.classList.toggle('active', alcoholFilterActive);
          applyFilters();
          return;
        }

        // Handle halal toggle separately
        if (btn.dataset.filter === 'halal') {
          halalFilterActive = !halalFilterActive;
          btn.classList.toggle('active', halalFilterActive);
          applyFilters();
          return;
        }

        // Handle cuisine filters (exclude the alcohol/halal toggle buttons from the reset)
        filtersEl.querySelectorAll('.map-filter-btn:not(.map-filter-alcohol):not(.map-filter-halal)').forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        activeCuisine = btn.dataset.cuisine || 'all';
        applyFilters();
      });
    }

    if (areaFiltersEl) {
      areaFiltersEl.addEventListener('click', function(e) {
        var btn = e.target.closest('.map-filter-btn');
        if (!btn) return;
        areaFiltersEl.querySelectorAll('.map-filter-btn').forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        activeArea = btn.dataset.area || 'all';
        applyFilters();
      });
    }
  }

  // "Current location" button — Geolocation API requires a secure context (HTTPS);
  // on plain HTTP other than localhost, getCurrentPosition is unavailable/will fail.
  var geoBtn = document.getElementById('map-geolocate-btn');
  if (geoBtn) {
    var geoBtnDefaultLabel = geoBtn.textContent;
    geoBtn.addEventListener('click', function() {
      if (!navigator.geolocation || !mapInstance || !window.google) return;
      geoBtn.disabled = true;
      function handleError() {
        // Permission denied or unavailable: fail silently (no alert), just relabel briefly.
        geoBtn.disabled = false;
        geoBtn.textContent = '取得できませんでした';
        setTimeout(function() { geoBtn.textContent = geoBtnDefaultLabel; }, 2500);
      }
      try {
        navigator.geolocation.getCurrentPosition(function(pos) {
          var latlng = { lat: pos.coords.latitude, lng: pos.coords.longitude };
          if (userLocationMarker) userLocationMarker.setMap(null);
          userLocationMarker = new google.maps.Marker({
            position: latlng,
            map: mapInstance,
            title: '現在地',
            zIndex: 999,
            icon: {
              path: google.maps.SymbolPath.CIRCLE,
              scale: 7,
              fillColor: '#4285F4',
              fillOpacity: 0.9,
              strokeColor: '#ffffff',
              strokeWeight: 2,
            },
          });
          mapInstance.panTo(latlng);
          if (mapInstance.getZoom() < 14) mapInstance.setZoom(14);
          geoBtn.disabled = false;
          geoBtn.textContent = geoBtnDefaultLabel;
        }, handleError, { enableHighAccuracy: true, timeout: 8000, maximumAge: 60000 });
      } catch (err) {
        // Some browsers/permission-policy contexts throw synchronously instead of
        // invoking the error callback; treat that the same as a failed lookup.
        handleError();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWhenVisible);
  } else {
    initWhenVisible();
  }
})();
</script>
