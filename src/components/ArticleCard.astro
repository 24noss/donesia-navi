---
import { categories, formatDate } from '../lib/categories';
import type { CategorySlug } from '../lib/categories';

interface Props {
  article: {
    id: string;
    data: {
      title: string;
      description: string;
      category: CategorySlug;
      pubDate: Date;
      source?: string;
      tags: string[];
    };
  };
  featured?: boolean;
}

const { article, featured = false } = Astro.props;
const cat = categories[article.data.category];
const url = `/articles/${article.id}/`;

function relativeTime(date: Date): string {
  const now = new Date();
  const diff = now.getTime() - date.getTime();
  const hours = Math.floor(diff / (1000 * 60 * 60));
  const days = Math.floor(diff / (1000 * 60 * 60 * 24));
  if (hours < 1) return '数分前';
  if (hours < 24) return `${hours}時間前`;
  if (days < 7) return `${days}日前`;
  return formatDate(date);
}
---

{featured ? (
  <a href={url} class={`front-hero cat-${cat.color}`}>
    <span class="front-hero-cat">{cat.name}</span>
    <h3 class="front-hero-title">{article.data.title}</h3>
    <p class="front-hero-desc">{article.data.description}</p>
    <div class="front-hero-meta">
      {article.data.source && <span class="source">{article.data.source}</span>}
      <span>{relativeTime(article.data.pubDate)}</span>
    </div>
  </a>
) : (
  <a href={url} class={`news-card cat-${cat.color}`}>
    <span class="news-card-cat">{cat.name}</span>
    <h4 class="news-card-title">{article.data.title}</h4>
    <p class="news-card-desc">{article.data.description}</p>
    <div class="news-card-meta">
      {article.data.source && <span class="source">{article.data.source}</span>}
      <span>{relativeTime(article.data.pubDate)}</span>
    </div>
  </a>
)}

<style>
  /* ===== Standard news card: typography-first, no imagery ===== */
  .news-card {
    --accent: var(--teal);
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius);
    padding: 18px 18px 16px;
    transition: border-color 0.15s ease;
  }
  .news-card:hover {
    border-color: var(--accent);
  }
  .news-card-cat {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 10px;
  }
  .news-card-title {
    font-family: var(--serif);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.5;
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s ease;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .news-card:hover .news-card-title {
    text-decoration-color: var(--accent);
  }
  .news-card-desc {
    margin-top: 8px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .news-card-meta {
    margin-top: auto;
    padding-top: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--text-muted);
  }
  .news-card-meta .source {
    color: var(--accent);
    font-weight: 500;
  }

  /* ===== Featured hero: front-page style, no photography ===== */
  .front-hero {
    --accent: var(--teal);
    display: block;
    background: var(--bg);
    border: 1px solid var(--border-light);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius-lg);
    padding: 32px 36px;
    transition: border-color 0.15s ease;
  }
  :global([data-theme="dark"]) .front-hero {
    background: var(--bg-card);
  }
  .front-hero:hover {
    border-color: var(--accent);
  }
  .front-hero-cat {
    display: inline-block;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: 14px;
  }
  .front-hero-title {
    font-family: var(--serif);
    font-weight: 900;
    font-size: clamp(1.5rem, 4vw, 2.4rem);
    line-height: 1.35;
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 5px;
    transition: text-decoration-color 0.2s ease;
  }
  .front-hero:hover .front-hero-title {
    text-decoration-color: var(--accent);
  }
  .front-hero-desc {
    margin-top: 16px;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-secondary);
    max-width: 62ch;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .front-hero-meta {
    margin-top: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--text-muted);
  }
  .front-hero-meta .source {
    color: var(--accent);
    font-weight: 600;
  }

  @media (max-width: 480px) {
    .news-card { padding: 14px 14px 12px; }
    .front-hero { padding: 24px 20px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .news-card, .front-hero, .news-card-title, .front-hero-title {
      transition: none;
    }
  }

  /* ===== Category accent colors (mirrors global.css .cat-dot palette) =====
     Kept after the base rules so equal-specificity --accent fallbacks don't win. */
  .cat-safety { --accent: var(--red); }
  .cat-society { --accent: var(--teal); }
  .cat-business { --accent: var(--gold); }
  .cat-gourmet { --accent: #C1502B; }
  .cat-lifestyle { --accent: #5BA88E; }
  .cat-travel { --accent: #8B6FBF; }
  .cat-visa { --accent: #D47B3E; }
  .cat-regulation { --accent: var(--navy-muted); }
</style>
