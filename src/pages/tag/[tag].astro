---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  const allTags = new Set<string>();
  articles.forEach(a => a.data.tags.forEach(t => allTags.add(t)));
  return [...allTags].map(tag => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const allArticles = await getCollection('articles', ({ data }) => !data.draft && data.tags.includes(tag));
const articles = allArticles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// タグ統制(src/data/tag-vocabulary.json)により、タグは71語彙に集約済み。
// 記事3本以上のタグは十分な情報量を持つSEOハブとみなしインデックス許可、
// 未満は薄い一覧としてnoindexにする(閾値はビルド時に記事数から自動判定)。
const INDEXABLE_MIN_ARTICLES = 3;
const isIndexable = articles.length >= INDEXABLE_MIN_ARTICLES;

const title = isIndexable
  ? `「${tag}」の記事一覧（${articles.length}件）`
  : `#${tag} の記事一覧`;
const description = isIndexable
  ? `ジャカルタ・インドネシアの「${tag}」に関する最新記事${articles.length}件。在住日本人向けにニュース・グルメ・生活情報をお届けします。`
  : `「${tag}」タグが付いた記事の一覧です。`;
---
<Base title={title} description={description} noindex={!isIndexable}>

  <div class="container static-page">

    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="パンくずリスト">
      <a href="/">ホーム</a>
      <span class="sep">></span>
      <span>タグ</span>
      <span class="sep">></span>
      <span>#{tag}</span>
    </nav>

    <h1>#{tag}</h1>
    <p style="font-size:13px;color:var(--text-muted);margin-bottom:24px;">
      「{tag}」タグが付いた記事 ({articles.length}件)
    </p>

    {articles.length === 0 ? (
      <p style="color:var(--text-muted);padding:2rem 0;">このタグの記事はまだありません。</p>
    ) : (
      articles.map((article) => (
        <ArticleCard article={article} />
      ))
    )}

    <div style="margin-top:2rem;">
      <a href="/" style="color:var(--teal);">&larr; トップに戻る</a>
    </div>

  </div>
</Base>
