---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StructuredData from '../../components/StructuredData.astro';
import RestaurantMap from '../../components/RestaurantMap.astro';
import { formatDate } from '../../lib/categories';
import { cuisineConfig, priceLabels } from '../../lib/cuisines';
import { getVisiblePlaces, placeToMapPoint, placeCategoryLabels } from '../../lib/places';
import { shouldIncludeDrafts } from '../../lib/draftVisibility';

export async function getStaticPaths() {
  const allPlaces = await getCollection('places');
  const allArticles = await getCollection('articles');
  const visiblePlaces = getVisiblePlaces(allPlaces, allArticles);
  return visiblePlaces.map((place) => ({
    params: { slug: place.id },
    props: { place, allArticles },
  }));
}

interface Props {
  place: CollectionEntry<'places'>;
  allArticles: CollectionEntry<'articles'>[];
}

const { place, allArticles } = Astro.props;
const { data } = place;

// この店を紹介した記事のうち、実在して表示可能なもの(draftプレビュービルドではdraftも含む)
const includeDrafts = shouldIncludeDrafts();
const articleById = new Map(allArticles.map((a) => [a.id, a]));
const sourceArticleEntries = data.sourceArticles
  .map((id) => articleById.get(id))
  .filter((a): a is CollectionEntry<'articles'> => !!a && (includeDrafts || !a.data.draft));

const placeUrl = new URL(`/places/${place.id}/`, Astro.site).href;
const googleMapsUrl = `https://www.google.com/maps/search/${encodeURIComponent(data.googleMapsQuery)}`;
const cc = data.cuisine ? cuisineConfig[data.cuisine as keyof typeof cuisineConfig] : undefined;
const priceLabel = data.priceRange ? priceLabels[data.priceRange] : undefined;
const categoryLabel = placeCategoryLabels[data.category];

const halalLabel: Record<string, string> = {
  yes: '🕌 ハラール対応',
  no: '🕌 ハラール非対応',
  unverified: '🕌 ハラール: 未確認',
};
const alcoholLabel: Record<string, string> = {
  yes: '🍺 お酒あり',
  no: '🍺 お酒なし',
  unverified: '🍺 お酒: 未確認',
};

const pageDescription = data.description
  || `${data.name}（${data.area}）の店舗情報。${categoryLabel}${cc ? ' / ' + cc.label : ''}・地図・紹介記事をまとめて確認できます。`;

const miniMapPoint = JSON.stringify([placeToMapPoint(place)]);
---
<Base title={data.name} description={pageDescription}>
  <StructuredData
    slot="head"
    type="place"
    place={data}
    placeUrl={placeUrl}
  />

  <div class="container place-page">

    <nav class="breadcrumb" aria-label="パンくずリスト">
      <a href="/">ホーム</a>
      <span class="sep">›</span>
      <a href="/map/">マップ</a>
      <span class="sep">›</span>
      <span>{data.name}</span>
    </nav>

    <header class="place-header">
      <span class="place-cat-pill">{categoryLabel}</span>
      {data.status === 'unverified' && <span class="place-cat-pill place-cat-pill-warn">要確認</span>}
      <h1 class="place-title">{data.name}</h1>
      {data.nameEn && <p class="place-title-en">{data.nameEn}</p>}

      <div class="place-badges">
        {cc && <span class="place-badge" style={`--badge-color:${cc.color}`}>{cc.icon} {cc.label}</span>}
        {priceLabel && <span class="place-badge place-badge-price">{priceLabel}</span>}
        {data.category === 'restaurant' && <span class="place-badge">{halalLabel[data.halal]}</span>}
        {data.category === 'restaurant' && <span class="place-badge">{alcoholLabel[data.servesAlcohol]}</span>}
        <span class="place-badge place-badge-area">📍 {data.area}</span>
      </div>
    </header>

    <section class="place-map-section">
      <RestaurantMap restaurants={miniMapPoint} height="320px" />
      <a href={googleMapsUrl} target="_blank" rel="noopener noreferrer" class="place-gmaps-link">Google Mapsで開く ↗</a>
    </section>

    {sourceArticleEntries.length > 0 && (
      <section class="place-section">
        <h2 class="place-section-title">この店を紹介した記事</h2>
        <ul class="place-article-list">
          {sourceArticleEntries.map((article) => (
            <li>
              <a href={`/articles/${article.id}/`}>{article.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <p class="place-verified-note">
      {data.verifiedAt
        ? `最終確認: ${formatDate(data.verifiedAt)}`
        : '最終確認: 未確認'}
    </p>

  </div>
</Base>

<style>
  /* 紙面型デザイン: オフホワイト背景+ネイビー文字+明朝見出し+ヘアライン罫線。
     グラデーション・光沢装飾は使わない(既存の記事ページ/マップページと統一)。 */
  .place-page {
    padding-top: 8px;
    padding-bottom: 60px;
    max-width: 720px;
  }

  .place-header {
    margin-bottom: 24px;
  }

  .place-cat-pill {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 20px;
    background: var(--gold-dim);
    color: var(--teal);
    margin-bottom: 12px;
    margin-right: 6px;
  }
  .place-cat-pill-warn {
    background: rgba(206, 59, 59, 0.1);
    color: var(--red);
  }

  .place-title {
    font-family: var(--serif);
    font-size: 28px;
    font-weight: 700;
    line-height: 1.4;
    color: var(--text);
    letter-spacing: -0.3px;
  }

  .place-title-en {
    font-size: 13px;
    color: var(--text-muted);
    margin-top: 4px;
  }

  .place-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  .place-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 12.5px;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    color: var(--text);
    background: var(--bg-card);
  }
  .place-badge-price {
    color: var(--teal);
    font-family: var(--serif);
  }
  .place-badge-area {
    color: var(--text-muted);
  }

  .place-map-section {
    margin-top: 8px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .place-gmaps-link {
    display: inline-block;
    margin-top: 12px;
    font-size: 13px;
    font-weight: 600;
    color: var(--teal);
  }
  .place-gmaps-link:hover {
    color: var(--text);
  }

  .place-section {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--border-light);
  }
  .place-section-title {
    font-family: var(--serif);
    font-size: 18px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 12px;
  }
  .place-article-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .place-article-list a {
    font-size: 14px;
    color: var(--teal);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .place-article-list a:hover {
    color: var(--text);
  }

  .place-verified-note {
    margin-top: 28px;
    font-size: 12.5px;
    color: var(--text-muted);
    padding: 8px 12px;
    background: var(--bg-sidebar);
    border-radius: var(--radius);
    width: fit-content;
  }
</style>
