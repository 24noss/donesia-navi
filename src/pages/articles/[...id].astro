---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StructuredData from '../../components/StructuredData.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import InternalLinks from '../../components/InternalLinks.astro';
import Sidebar from '../../components/Sidebar.astro';
import RestaurantMap from '../../components/RestaurantMap.astro';
import { categories, formatDate } from '../../lib/categories';
import { shouldIncludeDrafts } from '../../lib/draftVisibility';
import { getRelatedArticles } from '../../lib/related';
import { getVisiblePlaces, placeToMapPoint } from '../../lib/places';

export async function getStaticPaths() {
  const includeDrafts = shouldIncludeDrafts();
  const articles = await getCollection('articles', ({ data }) => !data.draft || includeDrafts);
  return articles.map((article) => ({ params: { id: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const cat = categories[article.data.category];
const articleUrl = new URL(`/articles/${article.id}/`, Astro.site).href;

// Get related articles for sidebar (shared scoring logic: category +2 / tag +1)
const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const related = getRelatedArticles(article, allArticles, 4);

const newArticles = [...allArticles]
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

// Freshness signals (B-3): show "最終更新" when present, and a periodic-review
// note for evergreen guide articles whose id has no date prefix.
const isGuideArticle = !/^\d{4}-\d{2}-\d{2}-/.test(article.id);
const lastReviewed = article.data.updatedDate ?? article.data.pubDate;

// This article's own store map (places whose sourceArticles include this article's id).
// getVisiblePlaces needs the FULL article set (including drafts) to resolve sourceArticles
// against draft status correctly — reusing the already-filtered `allArticles` above would
// make a draft article's own places invisible while previewing that same draft.
const allPlaces = await getCollection('places');
const allArticlesIncludingDrafts = await getCollection('articles');
// category: 'restaurant' 限定(C-1タスク2で病院等の非レストランplaceが追加されたため、
// この記事内ミニマップは従来通りレストラン専用のまま保つ)。
const articlePlaces = getVisiblePlaces(allPlaces, allArticlesIncludingDrafts)
  .filter((place) => place.data.category === 'restaurant' && place.data.sourceArticles.includes(article.id))
  .map(placeToMapPoint);
---
<Base
  title={article.data.title}
  description={article.data.description}
  ogType="article"
  publishedTime={article.data.pubDate.toISOString()}
  modifiedTime={(article.data.updatedDate ?? article.data.pubDate).toISOString()}
  articleSection={cat.name}
  articleTags={article.data.tags}
  ogImagePath={`/og/${article.id}.png`}
>
  <StructuredData
    slot="head"
    type="article"
    article={article.data}
    articleUrl={articleUrl}
  />

  <div class="container">

    {article.data.draft && (
      <div style="background:#fef3c7;border:1px solid #f59e0b;border-radius:8px;padding:12px 16px;margin:16px 0;font-size:14px;color:#92400e;">
        ⚠️ これは未公開のドラフト記事です（プレビュー専用）。本番サイトには表示されません。
      </div>
    )}

    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="パンくずリスト">
      <a href="/">ホーム</a>
      <span class="sep">›</span>
      <a href={`/category/${article.data.category}/`}>{cat.name}</a>
      <span class="sep">›</span>
      <span>{article.data.title}</span>
    </nav>

    <!-- Article Header -->
    <div class="article-header">
      <span class="article-cat-pill">{cat.name}</span>
      <h1 class="article-page-title" data-pagefind-body>{article.data.title}</h1>
      <div class="article-meta-row">
        <span>著者: DonesiaNavi編集部</span>
        <span class="divider">|</span>
        <span>{formatDate(article.data.pubDate)}</span>
        {article.data.updatedDate && (
          <>
            <span class="divider">|</span>
            <span>最終更新: {formatDate(article.data.updatedDate)}</span>
          </>
        )}
        {article.data.source && (
          <>
            <span class="divider">|</span>
            <span>ソース: {article.data.source}</span>
          </>
        )}
      </div>
      {isGuideArticle && (
        <p class="freshness-note">この記事は定期的に内容を見直しています（最終確認: {formatDate(lastReviewed)}）</p>
      )}
    </div>

    <div class="layout-2col-article">

      <!-- ARTICLE BODY -->
      <div class="main-col">

        <!-- TOC (auto-generated by JS) -->
        <div class="toc" id="toc" style="display:none;">
          <div class="toc-header" id="toc-toggle">
            <span>目次</span>
            <span class="toc-arrow">&#9660;</span>
          </div>
          <div class="toc-body" id="toc-body">
          </div>
        </div>

        {article.data.hasAffiliate && (
          <div class="inline-affiliate">
            <span class="pr-label">PR</span>
            <span>この記事にはアフィリエイト広告が含まれています。<a href="/policy/">詳細</a></span>
          </div>
        )}

        <!-- Body -->
        <div class="article-body" id="article-content" data-pagefind-body>
          <Content />
        </div>

        <!-- Source -->
        {article.data.sourceUrl && (
          <div class="article-source">
            <div class="article-source-title">情報ソース</div>
            <p><a href={article.data.sourceUrl} target="_blank" rel="noopener noreferrer">{article.data.source || '原文'}</a></p>
          </div>
        )}

        <!-- Disclaimer -->
        <div class="ai-disclosure">
          最新情報は公式ソースをご確認ください。
        </div>

        <!-- Restaurant map (only for articles with linked places) -->
        {articlePlaces.length > 0 && (
          <section class="article-map-section">
            <h2 class="article-map-heading">この記事のお店マップ</h2>
            <RestaurantMap restaurants={JSON.stringify(articlePlaces)} height="420px" />
          </section>
        )}

        <!-- Bottom share buttons -->
        <div style="margin-top:24px;">
          <ShareButtons url={articleUrl} title={article.data.title} direction="horizontal" />
        </div>

        <!-- Tags -->
        {article.data.tags.length > 0 && (
          <div class="tag-pills">
            {article.data.tags.map((tag: string) => (
              <a class="tag-pill" href={`/tag/${tag}/`}>{tag}</a>
            ))}
          </div>
        )}

        <!-- Internal Links for SEO -->
        <InternalLinks
          currentId={article.id}
          category={article.data.category}
          tags={article.data.tags}
        />

      </div>

      <!-- ARTICLE SIDEBAR -->
      <div class="sidebar-col desktop-only">
        <div class="sidebar-sticky">

          <!-- Affiliate Card -->
          <div class="affiliate-card">
            <span class="pr-badge">PR</span>
            <div class="aff-name">Wise（ワイズ）</div>
            <div class="aff-desc">海外送金の手数料を最大8倍節約。リアルタイム為替レートで日本への送金が簡単・お得に。</div>
            <a href="https://wise.com/invite/dic/shogon67" target="_blank" rel="noopener noreferrer" class="aff-cta">無料アカウント作成 →</a>
          </div>

          <!-- Related Articles -->
          {related.length > 0 && (
            <div class="widget">
              <div class="widget-title">関連記事</div>
              {related.map((rel) => (
                <div class="related-item">
                  <span class="related-cat">{categories[rel.data.category].name}</span>
                  <a class="related-title" href={`/articles/${rel.id}/`}>{rel.data.title}</a>
                  <div class="related-date">{formatDate(rel.data.pubDate)}</div>
                </div>
              ))}
            </div>
          )}

          <!-- Popular -->
          <div class="widget">
            <div class="widget-title"><span class="icon">&#127381;</span> 新着記事</div>
            <div class="popular-list">
              {newArticles.map((a, i) => (
                <div class="popular-item">
                  <span class="popular-num">{i + 1}</span>
                  <a class="popular-title" href={`/articles/${a.id}/`}>{a.data.title}</a>
                </div>
              ))}
            </div>
          </div>


        </div>
      </div>

    </div>

    <!-- Mobile share bar -->
    <div class="mobile-share-bar">
      <ShareButtons url={articleUrl} title={article.data.title} direction="horizontal" />
    </div>

  </div>

  <!-- TOC auto-generation script -->
  <script is:inline>
    (function(){
      var content = document.getElementById('article-content');
      var tocEl = document.getElementById('toc');
      var tocBody = document.getElementById('toc-body');
      var tocToggle = document.getElementById('toc-toggle');
      if (!content || !tocEl || !tocBody) return;

      var headings = content.querySelectorAll('h2');
      if (headings.length === 0) return;

      tocEl.style.display = 'block';

      headings.forEach(function(h, i) {
        var id = h.id || ('section-' + (i + 1));
        h.id = id;
        var link = document.createElement('a');
        link.className = 'toc-link';
        link.href = '#' + id;
        link.textContent = h.textContent;
        tocBody.appendChild(link);
      });

      if (tocToggle) {
        tocToggle.addEventListener('click', function() {
          tocEl.classList.toggle('collapsed');
        });
      }
    })();
  </script>
</Base>

<style>
  /* Freshness note for evergreen guide articles (B-3) */
  .freshness-note {
    margin-top: 12px;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--text-muted);
    padding: 8px 12px;
    background: var(--bg-sidebar);
    border-radius: var(--radius);
    width: fit-content;
  }

  /* Restaurant map embed for articles with linked places (B-3) */
  .article-map-section {
    margin-top: 32px;
    padding-top: 28px;
    border-top: 1px solid var(--border-light);
  }
  .article-map-heading {
    font-family: var(--serif);
    font-size: 20px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 16px;
  }
</style>
