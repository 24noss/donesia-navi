---
import '../styles/global.css';
import { categories } from '../lib/categories';

interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  articleSection?: string;
  articleTags?: string[];
  noindex?: boolean;
  ogImagePath?: string;
}

const {
  title,
  description = 'インドネシア在住日本人のための日本語ニュース・生活情報ポータル',
  ogType = 'website',
  publishedTime,
  modifiedTime,
  articleSection,
  articleTags = [],
  noindex = false,
  ogImagePath,
} = Astro.props;

const isHome = title.startsWith('DonesiaNavi');
const fullTitle = isHome ? title : `${title} | DonesiaNavi（ドネシアナビ）`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const siteUrl = Astro.site?.href ?? 'https://indonesia-navi.com';
// Articles pass their build-time-generated OG image path (see src/pages/og/[...id].png.ts);
// every other page keeps the site-wide default.
const ogImageUrl = ogImagePath ? new URL(ogImagePath, Astro.site).href : `${siteUrl}og-default.png`;

const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="ja" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="agd-partner-manual-verification" />
  <link rel="icon" type="image/png" href="/favicon.png" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@600;700;900&family=Noto+Sans+JP:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />

  <!-- Google Analytics (GA4) with Consent Mode v2 -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-VB1WN7G9N2"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    var storedConsent;
    try { storedConsent = localStorage.getItem('cookie_consent'); } catch (e) {}
    gtag('consent', 'default', {
      'analytics_storage': storedConsent === 'granted' ? 'granted' : 'denied'
    });
    gtag('js', new Date());
    gtag('config', 'G-VB1WN7G9N2');
  </script>

  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <title>{fullTitle}</title>

  <!-- Canonical & hreflang -->
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang="ja" href={canonicalUrl} />
  <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

  <!-- Sitemap -->
  <link rel="sitemap" href="/sitemap-index.xml" />

  <!-- RSS Feed -->
  <link rel="alternate" type="application/rss+xml" title="DonesiaNavi" href={`${siteUrl}rss.xml`} />

  <!-- Open Graph -->
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:locale" content="ja_JP" />
  <meta property="og:site_name" content="DonesiaNavi" />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={fullTitle} />

  {ogType === 'article' && publishedTime && (
    <meta property="article:published_time" content={publishedTime} />
  )}
  {ogType === 'article' && modifiedTime && (
    <meta property="article:modified_time" content={modifiedTime} />
  )}
  {ogType === 'article' && articleSection && (
    <meta property="article:section" content={articleSection} />
  )}
  {ogType === 'article' && articleTags.map((tag) => (
    <meta property="article:tag" content={tag} />
  ))}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <!-- Dark mode: restore preference before paint (falls back to OS preference
       when the visitor has never made an explicit choice) -->
  <script is:inline>
    (function(){
      var t = localStorage.getItem('theme');
      var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (t === 'dark' || (!t && prefersDark)) {
        document.documentElement.setAttribute('data-theme','dark');
      }
    })();
  </script>

  <!-- Structured data slot (injected by pages) -->
  <slot name="head" />
</head>
<body>

  <a href="#main" class="skip-link">本文へスキップ</a>

  <!-- HEADER -->
  <header class="header">
    <div class="header-inner">
      <a href="/" class="logo">
        <span class="logo-donesia">DONESIA</span><span class="logo-navi">NAV<span class="dot">i</span></span>
      </a>
      <div class="header-actions">
        <a href="/search/" class="header-btn" aria-label="検索" title="検索">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        </a>
        <button class="header-btn" id="theme-toggle" aria-label="ダークモード切替" title="ダークモード">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"/></svg>
        </button>
      </div>
    </div>
  </header>

  <!-- SUB NAV -->
  <nav class="subnav">
    <div class="subnav-inner">
      <a href="/" class={`subnav-link${currentPath === '/' ? ' active' : ''}`} aria-current={currentPath === '/' ? 'page' : undefined}>トップ</a>
      {Object.entries(categories).map(([slug, cat]) => (
        <a href={`/category/${slug}/`} class={`subnav-link${currentPath.startsWith(`/category/${slug}`) ? ' active' : ''}`} aria-current={currentPath.startsWith(`/category/${slug}`) ? 'page' : undefined}>{cat.name}</a>
      ))}
      <a href="/map/" class={`subnav-link${currentPath.startsWith('/map') ? ' active' : ''}`} aria-current={currentPath.startsWith('/map') ? 'page' : undefined}>マップ</a>
      <a href="/about/" class={`subnav-link${currentPath.startsWith('/about') ? ' active' : ''}`} aria-current={currentPath.startsWith('/about') ? 'page' : undefined}>このサイトについて</a>
    </div>
  </nav>

  <!-- MAIN CONTENT -->
  <main id="main">
    <slot />
  </main>

  <!-- FOOTER -->
  <footer class="site-footer">
    <div class="container">
      <p>&copy; {new Date().getFullYear()} DonesiaNavi</p>
      <div class="footer-links">
        <a href="/about/">このサイトについて</a>
        <a href="/policy/">ポリシー</a>
        {Object.entries(categories).map(([slug, cat]) => (
          <a href={`/category/${slug}/`}>{cat.name}</a>
        ))}
        <a href="/map/">マップ</a>
      </div>
    </div>
  </footer>

  <!-- MOBILE BOTTOM NAV -->
  <nav class="mobile-nav">
    <div class="mobile-nav-inner">
      <a href="/" class={`mobile-nav-item${currentPath === '/' ? ' active' : ''}`} aria-current={currentPath === '/' ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12l9-9 9 9"/><path d="M5 10v10a1 1 0 001 1h3a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1h3a1 1 0 001-1V10"/></svg>
        <span>ホーム</span>
      </a>
      <button class={`mobile-nav-item${currentPath.startsWith('/category') ? ' active' : ''}`} id="category-nav-btn" aria-label="カテゴリを開く">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
        <span>カテゴリ</span>
      </button>
      <a href="/search/" class={`mobile-nav-item${currentPath.startsWith('/search') ? ' active' : ''}`} aria-current={currentPath.startsWith('/search') ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <span>検索</span>
      </a>
      <a href="/map/" class={`mobile-nav-item${currentPath.startsWith('/map') ? ' active' : ''}`} aria-current={currentPath.startsWith('/map') ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <span>マップ</span>
      </a>
      <a href="/about/" class={`mobile-nav-item${currentPath.startsWith('/about') ? ' active' : ''}`} aria-current={currentPath.startsWith('/about') ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <span>サイト情報</span>
      </a>
    </div>
  </nav>

  <!-- CATEGORY OVERLAY -->
  <div class="category-overlay" id="category-overlay">
    <div class="category-overlay-header">
      <h2 class="category-overlay-title">カテゴリ</h2>
      <button class="category-overlay-close" id="category-overlay-close" aria-label="閉じる">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="category-overlay-list">
      {Object.entries(categories).map(([slug, cat]) => (
        <a href={`/category/${slug}/`} class="category-overlay-item">
          <span class={`cat-dot ${slug}`}></span>
          <span class="category-overlay-name">{cat.name}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
        </a>
      ))}
      <a href="/map/" class="category-overlay-item">
        <span class="category-overlay-name">🗺 生活マップ</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
      </a>
    </div>
  </div>

  <!-- COOKIE CONSENT BANNER -->
  <div class="consent-banner" id="consent-banner" role="region" aria-label="Cookie使用に関する同意">
    <p class="consent-text">当サイトはアクセス解析のためCookieを使用します。詳しくは<a href="/policy/">ポリシー</a>をご確認ください。</p>
    <div class="consent-actions">
      <button type="button" class="consent-btn consent-decline" id="consent-decline">拒否</button>
      <button type="button" class="consent-btn consent-accept" id="consent-accept">同意する</button>
    </div>
  </div>

  <!-- Dark mode toggle JS + Mobile nav JS -->
  <script is:inline>
    (function(){
      // Dark mode toggle
      var toggle = document.getElementById('theme-toggle');
      if (toggle) {
        toggle.addEventListener('click', function(){
          var html = document.documentElement;
          var current = html.getAttribute('data-theme');
          var next = current === 'dark' ? 'light' : 'dark';
          html.setAttribute('data-theme', next);
          localStorage.setItem('theme', next);
        });
      }

      // Category overlay
      var catBtn = document.getElementById('category-nav-btn');
      var catOverlay = document.getElementById('category-overlay');
      var catClose = document.getElementById('category-overlay-close');
      if (catBtn && catOverlay && catClose) {
        catBtn.addEventListener('click', function(){
          catOverlay.classList.add('open');
          document.body.style.overflow = 'hidden';
        });
        catClose.addEventListener('click', function(){
          catOverlay.classList.remove('open');
          document.body.style.overflow = '';
        });
        catOverlay.addEventListener('click', function(e){
          if (e.target === catOverlay) {
            catOverlay.classList.remove('open');
            document.body.style.overflow = '';
          }
        });
      }

      // Cookie consent banner
      var consentBanner = document.getElementById('consent-banner');
      var consentAccept = document.getElementById('consent-accept');
      var consentDecline = document.getElementById('consent-decline');
      if (consentBanner) {
        var consentChoice;
        try { consentChoice = localStorage.getItem('cookie_consent'); } catch (e) {}
        if (!consentChoice) {
          consentBanner.classList.add('show');
        }
        if (consentAccept) {
          consentAccept.addEventListener('click', function(){
            try { localStorage.setItem('cookie_consent', 'granted'); } catch (e) {}
            if (typeof gtag === 'function') {
              gtag('consent', 'update', { analytics_storage: 'granted' });
            }
            consentBanner.classList.remove('show');
          });
        }
        if (consentDecline) {
          consentDecline.addEventListener('click', function(){
            try { localStorage.setItem('cookie_consent', 'denied'); } catch (e) {}
            consentBanner.classList.remove('show');
          });
        }
      }
    })();
  </script>

</body>
</html>
