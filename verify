#!/usr/bin/env bash
# 完了判定の単一入口。exit 0 = 合格。--fast で重いステップを省略する。
# 外部API・Slack・デプロイ・クロールは呼ばない(npm test / npm run build のみ)。
set -euo pipefail

cd "$(dirname "$0")"

FAST=0
for a in "$@"; do
  case "$a" in
    --fast) FAST=1 ;;
    -h|--help) echo "usage: ./verify [--fast]"; exit 0 ;;
    *) echo "unknown arg: $a" >&2; exit 2 ;;
  esac
done

STEP=0
step() {
  local name="$1"; shift
  STEP=$((STEP + 1))
  echo "[verify] ($STEP) $name"
  if ! "$@"; then
    echo "[verify] FAIL: $name" >&2
    exit 1
  fi
}
slow_step() {
  if [ "$FAST" = 1 ]; then
    echo "[verify] skip(--fast): $1"
    return 0
  fi
  step "$@"
}

step "必須ファイルが存在する" test -f AGENTS.md -a -f STATE.md -a -f LESSONS.md
step "node_modules が存在する(無ければ npm ci)" test -d node_modules
step "test" npm test
slow_step "build" npm run build

echo "[verify] OK ($STEP steps)"
